---
interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

const { title, description, lang } = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.jpg" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
  </head>
  <body
    class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-amber-500 selection:text-slate-950"
  >
    <slot />
  </body>
</html>
