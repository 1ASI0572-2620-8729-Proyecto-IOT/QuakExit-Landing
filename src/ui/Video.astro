---
interface Props {
  title: string;
  description: string;
  srcLink: string;
}

const { title, description, srcLink } = Astro.props;
---

<!-- max-w-162.5  -->
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3>{title}</h3>
    <p class="text-gray-600 mb-4">{description}</p>
  </div>
  <iframe class="rounded w-full aspect-video" src={srcLink}></iframe>
</div>
