---
import Layout from "../layouts/layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import PainPoints from "../components/PainPoints.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AboutUs from "../components/AboutUs.astro";
import AudienceTabs from "../components/AudienceTabs.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import Pricing from "../components/Pricing.astro";
---

<Layout title="QuakExit | Seguridad Sísmica Residencial Inteligente">
  <Navbar />
  <main>
    <Hero />
    <PainPoints />
    <HowItWorks />
    <AboutUs />
    <AudienceTabs />
    <Pricing />
    <Faq />
    <ContactSection />
  </main>
  <footer
    class="py-8 border-t border-slate-900 text-center text-xs text-slate-500"
  >
    <p>
      © 2026 TerraGuard - QuakExit. Soluciones IoT para la preservación de la
      vida.
    </p>
  </footer>
</Layout>
