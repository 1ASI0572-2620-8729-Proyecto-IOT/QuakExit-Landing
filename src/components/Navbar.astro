---
import QuakExitLogo from "../images/logo.png";
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
  >
    <div class="flex items-center gap-2">
      <a href="#" class="flex items-center gap-3">
        <img src={QuakExitLogo.src} alt="QuakExit Logo" class="h-15 w-auto" />
      </a>
      <span
        class="text-xs text-slate-400 bg-slate-800/80 border border-slate-700 px-2 py-0.5 rounded-full"
        >by TerraGuard</span
      >
    </div>

    <nav class="hidden md:flex items-center gap-8 text-sm text-slate-300">
      <a href="#problema" class="hover:text-amber-400 transition">El Problema</a
      >
      <a href="#como-funciona" class="hover:text-amber-400 transition"
        >Cómo Funciona</a
      >
      <a href="#soluciones" class="hover:text-amber-400 transition"
        >Soluciones</a
      >
      <a href="#faq" class="hover:text-amber-400 transition">Preguntas</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 px-4 py-2 rounded-lg transition duration-200 shadow-md shadow-amber-500/10"
      >
        Cotizar Proyecto
      </a>
    </div>
  </div>
</header>
