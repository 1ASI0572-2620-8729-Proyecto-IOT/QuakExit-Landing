---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="como-funciona" class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        {t("how.title")}
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        {t("how.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <div
        class="relative bg-slate-900 border border-slate-800 p-8 rounded-2xl"
      >
        <span
          class="text-5xl font-black text-amber-500/20 absolute top-4 right-6"
          >01</span
        >
        <h3 class="text-xl font-bold text-white mb-3">{t("how.step1.title")}</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {t("how.step1.body")}
        </p>
      </div>

      <div
        class="relative bg-slate-900 border border-slate-800 p-8 rounded-2xl"
      >
        <span
          class="text-5xl font-black text-amber-500/20 absolute top-4 right-6"
          >02</span
        >
        <h3 class="text-xl font-bold text-white mb-3">{t("how.step2.title")}</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {t("how.step2.body")}
        </p>
      </div>

      <div
        class="relative bg-slate-900 border border-slate-800 p-8 rounded-2xl"
      >
        <span
          class="text-5xl font-black text-amber-500/20 absolute top-4 right-6"
          >03</span
        >
        <h3 class="text-xl font-bold text-white mb-3">
          {t("how.step3.title")}
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {t("how.step3.body")}
        </p>
      </div>
    </div>
  </div>
</section>
