---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

const faqs = [
  { q: t("faq.q1"), a: t("faq.a1") },
  { q: t("faq.q2"), a: t("faq.a2") },
  { q: t("faq.q3"), a: t("faq.a3") },
  { q: t("faq.q4"), a: t("faq.a4") },
];
---

<section id="faq" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        {t("faq.title")}
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        {t("faq.subtitle")}
      </p>
    </div>

    <div class="space-y-4">
      {
        faqs.map((item) => (
          <details class="group bg-slate-900 border border-slate-800 rounded-xl p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-white">
              <span>{item.q}</span>
              <span class="text-amber-500 transition-transform duration-200 group-open:rotate-180">
                ↓
              </span>
            </summary>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
