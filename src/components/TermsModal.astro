---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<dialog id="terms-modal" class="bg-slate-900 text-slate-100 p-6 rounded-xl shadow-2xl border border-slate-800 max-w-2xl w-full backdrop:bg-black/70">
  <div class="flex justify-between items-center mb-4 border-b border-slate-800 pb-3">
    <h3 class="text-xl font-bold text-emerald-400">{t("terms.title")}</h3>
    <button id="close-terms" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
  </div>
  
  <div class="space-y-4 text-sm text-slate-300 max-h-[60vh] overflow-y-auto pr-2">
    <p>{t("terms.body1")}</p>
    <p>{t("terms.body2")}</p>
  </div>

  <div class="mt-6 flex justify-end">
    <button id="btn-modal-close" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition">
      {t("terms.close")}
    </button>
  </div>
</dialog>

<script>
  const modal = document.getElementById('terms-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-terms');
  const btnModalClose = document.getElementById('btn-modal-close');

  const closeModal = () => modal?.close();

  closeBtn?.addEventListener('click', closeModal);
  btnModalClose?.addEventListener('click', closeModal);
</script>