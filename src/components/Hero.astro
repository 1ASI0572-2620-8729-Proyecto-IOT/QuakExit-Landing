---
import GooglePlayLogo from "../images/gplay.png";

import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative pt-20 pb-28 overflow-hidden">
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-87.5 bg-amber-500/15 blur-[120px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div
      class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-medium mb-8"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"
        ></span>
      </span>
      {t("hero.span")}
    </div>

    <h1
      class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight sm:leading-none"
    >
      {t("hero.title.pt1")} <span
        class="text-transparent bg-clip-text bg-linear-to-r from-amber-400 to-orange-500"
        >{t("hero.title.pt2")}</span
      >
    </h1>

    <p
      class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal"
    >
      {t("hero.p.pt1")} <strong class="text-white"
        >{t("hero.p.pt2")}</strong
      >
    </p>

    <!-- Botones de Acción y Plataformas -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <!-- Botón al Dashboard Web -->
      <a
        href="https://frontend-quak-exit.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 text-base font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl transition duration-200 shadow-lg shadow-amber-500/25"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"
          ></path>
        </svg>
        {t("hero.a.dash")}
      </a>

      <!-- Botón estilo Google Play Store -->
      <a
        href="https://playgooglecomquakexit.netlify.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white border border-slate-700 rounded-xl transition duration-200"
      >
        <img
          src={GooglePlayLogo.src}
          alt="Google Play logo"
          class="h-7 w-auto"
        />
        <div class="text-left leading-tight">
          <span
            class="block text-[10px] uppercase tracking-wider text-slate-400"
            >{t("hero.a.gplay")}</span
          >
          <span class="text-sm font-bold text-white">Google Play</span>
        </div>
      </a>
    </div>

    <!-- Indicadores clave -->
    <div
      class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto border-t border-slate-800/80 pt-8 text-left"
    >
      <div class="p-3">
        <p class="text-2xl font-black text-amber-400">&lt; 5s</p>
        <p class="text-xs text-slate-400">{t("hero.indicator.time")}</p>
      </div>
      <div class="p-3">
        <p class="text-2xl font-black text-amber-400">Edge IoT</p>
        <p class="text-xs text-slate-400">{t("hero.indicator.offline")}</p>
      </div>
      <div class="p-3">
        <p class="text-2xl font-black text-amber-400">Fail-Safe</p>
        <p class="text-xs text-slate-400">{t("hero.indicator.release")}</p>
      </div>
      <div class="p-3">
        <p class="text-2xl font-black text-amber-400">{t("hero.indicator.battery.title")}</p>
        <p class="text-xs text-slate-400">{t("hero.indicator.battery")}</p>
      </div>
    </div>
  </div>
</section>
