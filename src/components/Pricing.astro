---
const plans = [
  {
    name: "Kit Departamento",
    badge: "Pago Único",
    price: "S/ 499",
    subtitle: "Ideal para departamentos con 1 puerta principal de escape.",
    features: [
      "1 QuakExit Hub (ESP32 + Acelerómetro)",
      "1 Chapa electromagnética Fail-Safe",
      "Módulo de batería de respaldo integrada",
      "Acceso a App Móvil (Monitoreo y Simulacros)",
      "Instalación estándar incluida",
    ],
    cta: "Comprar Kit",
    highlight: false,
  },
  {
    name: "Kit Smart Home",
    badge: "Más Popular · Pago Único",
    price: "S/ 849",
    subtitle: "Cobertura completa de salida e iluminación para casas o dúplex.",
    features: [
      "1 QuakExit Hub de rango extendido",
      "Hasta 2 Chapas electromagnéticas Fail-Safe",
      "Kit de relés para luces de ruta de evacuación",
      "Batería de alta autonomía (Modo Deep Sleep)",
      "App Móvil + Alertas SMS a 5 contactos",
      "Instalación y calibración certificada",
    ],
    cta: "Solicitar Kit Plus",
    highlight: true,
  },
  {
    name: "Inmobiliarias B2B",
    badge: "Por Volumen",
    price: "A medida",
    subtitle:
      "Integración en planos y fase de acabados para edificios multifamiliares.",
    features: [
      "Hardware por lotes con descuento de escala",
      "Acceso al Web Dashboard B2B centralizado",
      "Configuración masiva por CSV / MAC Address",
      "Certificación y protocolos alineados a INDECI",
      "Soporte técnico en obra para ingenieros",
    ],
    cta: "Cotizar Proyecto",
    highlight: false,
  },
];
---

<section id="planes" class="py-24 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        Planes y Precios
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        Sin suscripciones mensuales forzosas
      </p>
      <p class="mt-3 text-sm text-slate-400">
        Adquiere tu equipo con un único pago o integra seguridad sísmica a
        escala en tu próximo edificio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        plans.map((plan) => (
          <div
            class={`rounded-2xl p-8 flex flex-col justify-between border ${
              plan.highlight
                ? "bg-gradient-to-b from-amber-500/10 to-slate-950 border-amber-500 shadow-xl shadow-amber-500/10"
                : "bg-slate-900/60 border-slate-800"
            }`}
          >
            <div>
              <span
                class={`inline-block text-xs font-bold px-3 py-1 rounded-full mb-4 ${
                  plan.highlight
                    ? "bg-amber-500 text-slate-950"
                    : "bg-slate-800 text-slate-300"
                }`}
              >
                {plan.badge}
              </span>
              <h3 class="text-xl font-bold text-white">{plan.name}</h3>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="text-4xl font-black text-white">{plan.price}</span>
              </div>
              <p class="mt-2 text-xs text-slate-400">{plan.subtitle}</p>

              <ul class="mt-6 space-y-3 border-t border-slate-800/80 pt-6 text-sm text-slate-300">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-amber-400 font-bold">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href="#contacto"
              class={`mt-8 block w-full py-3 text-center text-sm font-bold rounded-xl transition ${
                plan.highlight
                  ? "bg-amber-500 hover:bg-amber-400 text-slate-950"
                  : "bg-slate-800 hover:bg-slate-700 text-white"
              }`}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
