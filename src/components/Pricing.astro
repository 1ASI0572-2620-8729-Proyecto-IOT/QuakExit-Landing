---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const plans = [
  {
    name: t("pricing.department.name"),
    badge: t("pricing.department.badge"),
    price: "S/ 499",
    cloudFee: t("pricing.department.fee"),
    hardware: [
      t("pricing.department.hw1"),
      t("pricing.department.hw2"),
      t("pricing.department.hw3"),
      t("pricing.department.hw4"),
    ],
    cloudTitle: t("pricing.department.cloud.title"),
    cloudFeatures: [
      t("pricing.department.cloud1"),
      t("pricing.department.cloud2"),
      t("pricing.department.cloud3"),
      t("pricing.department.cloud4"),
      t("pricing.department.cloud5"),
      t("pricing.department.cloud6"),
      t("pricing.department.cloud7"),
      t("pricing.department.cloud8"),
      t("pricing.department.cloud9"),
    ],
    upcoming: [],
    cta: t("pricing.department.cta"),
    highlight: false,
  },
  {
    name: t("pricing.smart.name"),
    badge: t("pricing.smart.badge"),
    price: "S/ 849",
    cloudFee: t("pricing.smart.fee"),
    hardware: [
      t("pricing.smart.hw1"),
      t("pricing.smart.hw2"),
      t("pricing.smart.hw3"),
      t("pricing.smart.hw4"),
      t("pricing.smart.hw5"),
    ],
    cloudTitle: t("pricing.smart.cloud.title"),
    cloudFeatures: [
      t("pricing.smart.cloud1"),
      t("pricing.smart.cloud2"),
      t("pricing.smart.cloud3"),
      t("pricing.smart.cloud4"),
      t("pricing.smart.cloud5"),
    ],
    upcoming: [
      t("pricing.smart.upcoming1"),
      t("pricing.smart.upcoming2"),
      t("pricing.smart.upcoming3"),
      t("pricing.smart.upcoming4"),
    ],
    cta: t("pricing.smart.cta"),
    highlight: true,
  },
  {
    name: t("pricing.business.name"),
    badge: t("pricing.business.badge"),
    price: lang === "en" ? "Custom" : "A medida",
    cloudFee: t("pricing.business.fee"),
    hardware: [
      t("pricing.business.hw1"),
      t("pricing.business.hw2"),
      t("pricing.business.hw3"),
    ],
    cloudTitle: t("pricing.business.cloud.title"),
    cloudFeatures: [
      t("pricing.business.cloud1"),
      t("pricing.business.cloud2"),
      t("pricing.business.cloud3"),
      t("pricing.business.cloud4"),
      t("pricing.business.cloud5"),
      t("pricing.business.cloud6"),
      t("pricing.business.cloud7"),
    ],
    upcoming: [t("pricing.business.upcoming1")],
    cta: t("pricing.business.cta"),
    highlight: false,
  },
  {
    name: t("pricing.enterprise.name"),
    badge: t("pricing.enterprise.badge"),
    price: lang === "en" ? "Custom" : "A medida",
    cloudFee: t("pricing.enterprise.fee"),
    hardware: [
      t("pricing.enterprise.hw1"),
      t("pricing.enterprise.hw2"),
    ],
    cloudTitle: t("pricing.enterprise.cloud.title"),
    cloudFeatures: [
      t("pricing.enterprise.cloud1"),
      t("pricing.enterprise.cloud2"),
      t("pricing.enterprise.cloud3"),
    ],
    upcoming: [
      t("pricing.enterprise.upcoming1"),
      t("pricing.enterprise.upcoming2"),
      t("pricing.enterprise.upcoming3"),
      t("pricing.enterprise.upcoming4"),
    ],
    cta: t("pricing.enterprise.cta"),
    highlight: false,
  },
];
---

<section id="planes" class="py-24 border-t border-slate-800 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-6">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">{t("pricing.title")}</h2>
      <p class="mt-2 text-3xl sm:text-4xl font-extrabold text-white">{t("pricing.subtitle")}</p>
    </div>

    <!-- Banner aclaratorio offline -->
    <div class="max-w-3xl mx-auto mb-16 p-4 rounded-xl border border-amber-500/30 bg-amber-500/10 text-center">
      <p class="text-sm text-slate-200">
        <strong class="text-amber-400">{t("pricing.guarantee.title")}</strong> {t("pricing.guarantee.body")} <span class="text-white font-semibold">{t("pricing.guarantee.emphasis")}</span> {t("pricing.guarantee.end")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {plans.map((plan) => (
        <div class={`rounded-2xl p-6 flex flex-col justify-between border ${
          plan.highlight 
            ? "bg-linear-to-b from-amber-500/10 to-slate-900 border-amber-500 shadow-xl shadow-amber-500/10" 
            : "bg-slate-900/60 border-slate-800"
        }`}>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${
                plan.highlight ? "bg-amber-500 text-slate-950" : "bg-slate-800 text-slate-300"
              }`}>
                {plan.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white">{plan.name}</h3>
            
            <div class="mt-3">
              <span class="text-3xl font-black text-white">{plan.price}</span>
              <p class="text-xs text-amber-400/90 mt-1 font-medium leading-relaxed">{plan.cloudFee}</p>
            </div>

            <!-- Hardware -->
            <div class="mt-6 border-t border-slate-800 pt-4">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">{t("pricing.hardware")}</p>
              <ul class="space-y-2 text-xs text-slate-300">
                {plan.hardware.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-400 font-bold shrink-0">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Cloud -->
            <div class="mt-6 border-t border-slate-800 pt-4">
              <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">{plan.cloudTitle}</p>
              <ul class="space-y-2 text-xs text-slate-300">
                {plan.cloudFeatures.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-400 shrink-0">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Próximamente -->
            {plan.upcoming.length > 0 && (
              <div class="mt-6 border-t border-slate-800/60 pt-4">
                <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">{t("pricing.upcoming")}</p>
                <ul class="space-y-1.5 text-xs text-slate-400">
                  {plan.upcoming.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-slate-600 shrink-0">✦</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <a href="#contacto" class={`mt-8 block w-full py-2.5 text-center text-xs font-bold rounded-xl transition ${
            plan.highlight 
              ? "bg-amber-500 hover:bg-amber-400 text-slate-950" 
              : "bg-slate-800 hover:bg-slate-700 text-white"
          }`}>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>