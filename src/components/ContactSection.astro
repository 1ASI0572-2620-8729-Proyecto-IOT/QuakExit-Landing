---

---

<section id="contacto" class="py-20 bg-slate-900/60 border-t border-slate-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        Contacto Directo
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        Cotiza o integra QuakExit en tu proyecto
      </p>
      <p class="text-slate-400 text-sm mt-2">
        Déjanos tus datos y te responderemos en breve con la propuesta técnica
        adecuada.
      </p>
    </div>

    <form
      class="space-y-4 bg-slate-950 p-8 rounded-2xl border border-slate-800 shadow-xl"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1"
            >Nombre Completo</label
          >
          <input
            type="text"
            required
            placeholder="Tu nombre"
            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1"
            >Correo Electrónico</label
          >
          <input
            type="email"
            required
            placeholder="correo@ejemplo.com"
            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1"
          >Perfil de Interés</label
        >
        <select
          class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        >
          <option value="residencial"
            >Dueño de hogar / Smart Home (Kit Residencial)</option
          >
          <option value="inmobiliaria"
            >Constructora / Inmobiliaria (Proyecto multifamiliar)</option
          >
          <option value="arquitecto"
            >Arquitecto / Diseñador de Interiores</option
          >
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1"
          >Mensaje o Detalle del Inmueble</label
        >
        <textarea
          rows="4"
          placeholder="Indícanos distrito, número de departamentos o detalles específicos..."
          class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl transition duration-200 shadow-lg shadow-amber-500/20"
      >
        Enviar Solicitud
      </button>
    </form>
  </div>
</section>
