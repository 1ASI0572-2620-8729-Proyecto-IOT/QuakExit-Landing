---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section
  id="soluciones"
  class="py-20 bg-slate-900/40 border-t border-slate-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        {t("audience.title")}
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        {t("audience.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Tarjeta B2C -->
      <div
        class="border border-slate-800 bg-slate-950 p-8 rounded-2xl flex flex-col justify-between"
      >
        <div>
          <div
            class="inline-block px-3 py-1 bg-amber-500/10 text-amber-400 text-xs font-bold rounded-lg mb-4"
          >
            {t("audience.home.badge")}
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            {t("audience.home.title")}
          </h3>
          <p class="text-sm text-slate-400 mb-6 leading-relaxed">
            {t("audience.home.body")}
          </p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.home.feature1")}
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.home.feature2")}
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.home.feature3")}
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            href="#contacto"
            class="block w-full py-3 text-center text-sm font-bold bg-slate-800 hover:bg-slate-700 text-white rounded-xl transition"
          >
            {t("audience.home.cta")}
          </a>
        </div>
      </div>

      <!-- Tarjeta B2B -->
      <div
        class="border border-amber-500/30 bg-linear-to-b from-amber-500/5 to-transparent p-8 rounded-2xl flex flex-col justify-between"
      >
        <div>
          <div
            class="inline-block px-3 py-1 bg-amber-500 text-slate-950 text-xs font-black rounded-lg mb-4"
          >
            {t("audience.business.badge")}
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            {t("audience.business.title")}
          </h3>
          <p class="text-sm text-slate-400 mb-6 leading-relaxed">
            {t("audience.business.body")}
          </p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.business.feature1")}
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.business.feature2")}
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> {t("audience.business.feature3")}
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            href="#contacto"
            class="block w-full py-3 text-center text-sm font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl transition"
          >
            {t("audience.business.cta")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
