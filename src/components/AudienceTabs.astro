---

---

<section
  id="soluciones"
  class="py-20 bg-slate-900/40 border-t border-slate-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest">
        Adaptado a cada necesidad
      </h2>
      <p class="mt-2 text-3xl font-extrabold text-white">
        Seguridad residencial individual y a escala
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Tarjeta B2C -->
      <div
        class="border border-slate-800 bg-slate-950 p-8 rounded-2xl flex flex-col justify-between"
      >
        <div>
          <div
            class="inline-block px-3 py-1 bg-amber-500/10 text-amber-400 text-xs font-bold rounded-lg mb-4"
          >
            Para Familias & Smart Homes
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            Protección autónoma en tu departamento
          </h3>
          <p class="text-sm text-slate-400 mb-6 leading-relaxed">
            Kit listo para instalar en tu puerta principal y pasillo. Diseñado
            para integrarse estéticamente sin alterar la decoración de tu
            vivienda.
          </p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Batería con modo Deep Sleep para
              autonomía prolongada
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> App móvil (Flutter) para monitorear
              carga y realizar simulacros
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Modelo de pago único (dispositivo
              + instalación)
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            href="#contacto"
            class="block w-full py-3 text-center text-sm font-bold bg-slate-800 hover:bg-slate-700 text-white rounded-xl transition"
          >
            Solicitar Kit Residencial
          </a>
        </div>
      </div>

      <!-- Tarjeta B2B -->
      <div
        class="border border-amber-500/30 bg-gradient-to-b from-amber-500/5 to-transparent p-8 rounded-2xl flex flex-col justify-between"
      >
        <div>
          <div
            class="inline-block px-3 py-1 bg-amber-500 text-slate-950 text-xs font-black rounded-lg mb-4"
          >
            Para Inmobiliarias & Constructoras
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">
            Diferenciador: Seguridad Sísmica Inteligente
          </h3>
          <p class="text-sm text-slate-400 mb-6 leading-relaxed">
            Aumenta el valor por metro cuadrado de tus proyectos multifamiliares
            integrando QuakExit directamente desde los planos eléctricos y fase
            de acabados.
          </p>
          <ul class="space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Tablero web centralizado B2B para
              monitoreo de todo el edificio
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Aprovisionamiento masivo por lote
              (carga vía CSV / MAC address)
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Cumplimiento y alineación con
              criterios preventivos de evacuación
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            href="#contacto"
            class="block w-full py-3 text-center text-sm font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl transition"
          >
            Solicitar Asesoría de Proyecto B2B
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
